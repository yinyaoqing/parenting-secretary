    "data:check": "node scripts/build-data.mjs --check",
    "data:build": "node scripts/build-data.mjs",
    "test:search": "node --experimental-strip-types --no-warnings src/search/search.test.ts",
    "content:build:release": "node scripts/build-content.mjs --release",
    "eas-build-post-install": "node scripts/eas-post-install.mjs",
    "test:calendar": "node --experimental-strip-types --no-warnings src/calendar/calendar.test.ts",
    "legal:build": "node scripts/build-legal.mjs"
