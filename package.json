  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "content:check": "node scripts/check-content.mjs",
    "content:check:net": "node scripts/check-content.mjs --net",
    "typecheck": "tsc --noEmit",
    "content:build": "node scripts/build-content.mjs",
    "content:bilingual": "node scripts/export-bilingual.mjs",
    "prestart": "node scripts/build-content.mjs",
    "lint": "expo lint",
    "publish:preview": "node scripts/publish-preview.mjs",
    "content:import": "node scripts/import-translation.mjs",
    "test:sync": "node --experimental-strip-types --no-warnings src/sync/merge.test.ts && node --experimental-strip-types --no-warnings src/sync/codec.test.ts && node --experimental-strip-types --no-warnings src/sync/backup.test.ts",
    "test:timeline": "node --experimental-strip-types --no-warnings src/timeline/timeline.test.ts",
